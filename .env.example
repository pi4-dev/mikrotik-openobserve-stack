TZ=Europe/Warsaw

# Component versions/tags. Override deliberately when upgrading the stack.
OPENOBSERVE_VERSION=v0.92.2
# GoFlow2 Docker Hub uses branch/commit tags rather than release-number tags.
# 2d10ea3 is the pinned multi-arch image from the v2 branch.
GOFLOW2_TAG=2d10ea3
SYSLOG_NG_VERSION=4.12.0
ALPINE_VERSION=3.23

# OpenObserve UI/API
OPENOBSERVE_PORT=5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=change-me-now

# Collector ports exposed on the Docker host
SYSLOG_PORT=5514
NETFLOW_PORT=2055
