TZ=Europe/Warsaw

# Component versions/tags. Override deliberately when upgrading the stack.
OPENOBSERVE_VERSION=v0.92.2
# GoFlow2 Docker Hub uses branch/commit tags rather than release-number tags.
# 2d10ea3 is the pinned multi-arch image from the v2 branch.
GOFLOW2_TAG=2d10ea3
SYSLOG_NG_VERSION=4.12.0
ALPINE_VERSION=3.23

# OpenObserve UI/API
OPENOBSERVE_PORT=5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=change-me-now

# MaxMind GeoLite databases used by the built-in OpenObserve enrichment tables:
#   maxmind_city
#   maxmind_asn
#
# OpenObserve defaults ZO_MMDB_DISABLE_DOWNLOAD to true. This stack enables
# automatic download so netflow_geoip.vrl works without manually uploading a
# CSV enrichment table. MMDB files are stored below the persistent /data mount.
ZO_MMDB_DISABLE_DOWNLOAD=false
ZO_MMDB_DATA_DIR=/data/mmdb
ZO_MMDB_UPDATE_DURATION_DAYS=30

# OpenObserve's current default GeoLite mirror and SHA256 files. Override these
# if you operate your own mirror or use another trusted MaxMind distribution.
ZO_MMDB_GEOLITE_CITYDB_URL=https://geoip.zinclabs.dev/GeoLite2-City.mmdb
ZO_MMDB_GEOLITE_ASNDB_URL=https://geoip.zinclabs.dev/GeoLite2-ASN.mmdb
ZO_MMDB_GEOLITE_CITYDB_SHA256_URL=https://geoip.zinclabs.dev/GeoLite2-City.sha256
ZO_MMDB_GEOLITE_ASNDB_SHA256_URL=https://geoip.zinclabs.dev/GeoLite2-ASN.sha256

# Collector ports exposed on the Docker host
SYSLOG_PORT=5514
NETFLOW_PORT=2055
