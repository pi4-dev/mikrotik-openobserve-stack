# OpenObserve / VRL function: netflow_direction
#
# Classifies a flow by comparing source and destination addresses with the
# networks considered internal to the monitored environment.
#
# Output fields:
#   internet_flow = true when exactly one endpoint is internal
#   direction     = outbound | inbound | internal | external
#
# Customize internal_nets to match your routed/private address space.

internal_nets = [
    "10.0.0.0/8",
    "192.168.0.0/16"
]

src_addr = string(.src_addr) ?? ""
dst_addr = string(.dst_addr) ?? ""

src_internal = ip_cidr_contains(internal_nets, src_addr) ?? false
dst_internal = ip_cidr_contains(internal_nets, dst_addr) ?? false

.internet_flow =
    (src_internal && !dst_internal) ||
    (!src_internal && dst_internal)

if src_internal && !dst_internal {
    .direction = "outbound"
} else if !src_internal && dst_internal {
    .direction = "inbound"
} else if src_internal && dst_internal {
    .direction = "internal"
} else {
    .direction = "external"
}

.
